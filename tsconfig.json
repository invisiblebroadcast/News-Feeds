{
  "compilerOptions": {
    "target": "ES2020",
    "module": "none",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "outDir": "js",
    "rootDir": "js",
    "strict": false,
    "noImplicitAny": false,
    "allowJs": false,
    "checkJs": false,
    "declaration": false,
    "sourceMap": false,
    "skipLibCheck": true,
    "removeComments": false
  },
  "include": ["js/**/*.ts"],
  "exclude": ["js/lib/**"]
}
